@model Inscripcion
@{
    ViewData["Title"] = "Inscripción confirmada";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <h1 class="h2">¡Inscripción confirmada!</h1>
            <p class="text-muted">Gracias, @Model.NombreEstudiante. Te contactaremos a @Model.Correo.</p>
        </div>

        <dl class="row">
            <dt class="col-sm-4">N.° de inscripción</dt>
            <dd class="col-sm-8">@Model.Id</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CursoId)</dt>
            <dd class="col-sm-8">@Model.NombreCurso</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Horario)</dt>
            <dd class="col-sm-8">@Model.Horario</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Meses)</dt>
            <dd class="col-sm-8">@Model.Meses</dd>
            <dt class="col-sm-4">Descuento</dt>
            <dd class="col-sm-8">@Model.Descuento.ToString("C0")</dd>
            <dt class="col-sm-4">Total a pagar</dt>
            <dd class="col-sm-8 fw-bold">@Model.Total.ToString("C0")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FechaInscripcion)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.FechaInscripcion)</dd>
        </dl>

        <a class="btn btn-dark" asp-action="Index">Ver inscripciones</a>
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Inicio</a>
    </div>
</div>
